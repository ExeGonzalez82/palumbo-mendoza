---
const staff = [
  {
    name: 'Pablo Navarro',
    position: 'Jefe de Ventas',
    email: 'jefe_ventas@hormimac.com.ar',
    whatsapp: '5492616202177',
    whatsappDisplay: '261 620-2177',
    initials: 'PN',
  },
  {
    name: 'Mario Marchini',
    position: 'Vendedor',
    email: 'mario@hormimac.com.ar',
    whatsapp: '5492612065244',
    whatsappDisplay: '261 206-5244',
    initials: 'MM',
  },
];
---

<section id="staff" class="section-padding bg-dark">
  <div class="section-container">

    <!-- Header -->
    <div class="mb-14">
      <div class="flex items-center gap-3 mb-4 gsap-reveal">
        <span class="block w-8 h-px bg-accent"></span>
        <span class="text-xs font-bold tracking-[0.3em] uppercase text-accent">Equipo</span>
      </div>
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <h2 class="section-title text-light gsap-reveal text-balance">
          Staff de Ventas
        </h2>
        <p class="section-subtitle text-light/60 max-w-sm gsap-reveal text-balance">
          Nuestro equipo está disponible para asesorarte en cada etapa de tu proyecto.
        </p>
      </div>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl">
      {staff.map((person, i) => (
        <div
          class="gsap-reveal bg-white/5 border border-white/10 hover:border-accent/60 transition-all duration-300 group p-6"
          style={`transition-delay: ${i * 80}ms`}
        >
          <!-- Avatar -->
          <div class="w-14 h-14 bg-accent flex items-center justify-center mb-5 text-dark font-black text-lg tracking-tight">
            {person.initials}
          </div>

          <!-- Info -->
          <h3 class="text-base font-bold text-light mb-0.5">{person.name}</h3>
          <p class="text-xs font-semibold text-accent tracking-wide uppercase mb-5">{person.position}</p>

          <!-- Divider -->
          <div class="h-px bg-white/10 mb-5"></div>

          <!-- Contact -->
          <ul class="flex flex-col gap-2.5">
            <li>
              <a
                href={`https://wa.me/${person.whatsapp}`}
                target="_blank"
                rel="noopener"
                class="flex items-center gap-2 text-sm text-light/60 hover:text-accent transition-colors duration-200"
              >
                <svg class="w-3.5 h-3.5 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                {person.whatsappDisplay}
              </a>
            </li>
            <li>
              <a
                href={`mailto:${person.email}`}
                class="flex items-center gap-2 text-sm text-light/60 hover:text-accent transition-colors duration-200 break-all"
              >
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                {person.email}
              </a>
            </li>
          </ul>
        </div>
      ))}
    </div>

  </div>
</section>
