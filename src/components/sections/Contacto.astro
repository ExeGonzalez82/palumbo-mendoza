---
---

<section id="contacto" class="section-padding bg-dark">
  <div class="section-container">

    <!-- Header -->
    <div class="mb-14">
      <div class="flex items-center gap-3 mb-4 gsap-reveal">
        <span class="block w-8 h-px bg-accent"></span>
        <span class="text-xs font-bold tracking-[0.3em] uppercase text-accent">Contacto</span>
      </div>
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <h2 class="section-title text-light gsap-reveal text-balance">
          Hablemos de tu Proyecto
        </h2>
        <p class="section-subtitle text-light/60 max-w-sm gsap-reveal text-balance">
          Completá el formulario y un asesor te contactará dentro de las 24 horas hábiles.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-16">

      <!-- Form column -->
      <div class="lg:col-span-3 gsap-reveal">
        <form
          name="contacto"
          method="POST"
          class="space-y-5"
          novalidate
          id="contact-form"
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="nombre" class="block text-xs font-bold tracking-widest uppercase text-light/50 mb-2">
                Nombre *
              </label>
              <input
                type="text"
                id="nombre"
                name="nombre"
                required
                class="w-full bg-white/5 border border-white/15 text-light placeholder-white/30 px-4 py-3 text-sm focus:outline-none focus:border-accent transition-colors duration-200"
                placeholder="Juan Pérez"
              />
            </div>
            <div>
              <label for="empresa-input" class="block text-xs font-bold tracking-widest uppercase text-light/50 mb-2">
                Empresa
              </label>
              <input
                type="text"
                id="empresa-input"
                name="empresa"
                class="w-full bg-white/5 border border-white/15 text-light placeholder-white/30 px-4 py-3 text-sm focus:outline-none focus:border-accent transition-colors duration-200"
                placeholder="Constructora XYZ"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="email" class="block text-xs font-bold tracking-widest uppercase text-light/50 mb-2">
                Email *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full bg-white/5 border border-white/15 text-light placeholder-white/30 px-4 py-3 text-sm focus:outline-none focus:border-accent transition-colors duration-200"
                placeholder="juan@ejemplo.com"
              />
            </div>
            <div>
              <label for="telefono" class="block text-xs font-bold tracking-widest uppercase text-light/50 mb-2">
                Teléfono
              </label>
              <input
                type="tel"
                id="telefono"
                name="telefono"
                class="w-full bg-white/5 border border-white/15 text-light placeholder-white/30 px-4 py-3 text-sm focus:outline-none focus:border-accent transition-colors duration-200"
                placeholder="+54 261 000-0000"
              />
            </div>
          </div>

          <div>
            <label for="tipo" class="block text-xs font-bold tracking-widest uppercase text-light/50 mb-2">
              Tipo de consulta *
            </label>
            <select
              id="tipo"
              name="tipo"
              required
              class="w-full bg-white/5 border border-white/15 text-light px-4 py-3 text-sm focus:outline-none focus:border-accent transition-colors duration-200 appearance-none"
            >
              <option value="" class="bg-dark" disabled selected>Seleccioná una opción</option>
              <option value="cotizacion" class="bg-dark">Cotización de hormigón</option>
              <option value="obra-residencial" class="bg-dark">Obra residencial</option>
              <option value="obra-comercial" class="bg-dark">Obra comercial / industrial</option>
              <option value="obra-publica" class="bg-dark">Obra pública</option>
              <option value="especificaciones" class="bg-dark">Consulta técnica</option>
              <option value="otro" class="bg-dark">Otro</option>
            </select>
          </div>

          <div>
            <label for="mensaje" class="block text-xs font-bold tracking-widest uppercase text-light/50 mb-2">
              Mensaje *
            </label>
            <textarea
              id="mensaje"
              name="mensaje"
              required
              rows="5"
              class="w-full bg-white/5 border border-white/15 text-light placeholder-white/30 px-4 py-3 text-sm focus:outline-none focus:border-accent transition-colors duration-200 resize-none"
              placeholder="Describí tu proyecto: tipo de obra, metros cúbicos estimados, fecha de hormigonado..."
            ></textarea>
          </div>

          <div>
            <button
              type="submit"
              class="btn-primary w-full sm:w-auto justify-center"
            >
              Enviar consulta
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </button>
          </div>
        </form>
      </div>

      <!-- Info + Map column -->
      <div class="lg:col-span-2 flex flex-col gap-8 gsap-reveal">

        <!-- Contact info -->
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="w-9 h-9 bg-accent flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold tracking-widest uppercase text-light/40 mb-1">Planta</p>
              <p class="text-sm text-light/80 leading-relaxed">Acc. Sur - Lat. Este 8500<br/>Luján de Cuyo, Mendoza</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-9 h-9 bg-accent flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold tracking-widest uppercase text-light/40 mb-1">Horarios</p>
              <p class="text-sm text-light/80 leading-relaxed">Lunes a Viernes: 7:00 – 18:00<br/>Sábados: 7:00 – 13:00</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-9 h-9 bg-accent flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 8V5z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold tracking-widest uppercase text-light/40 mb-1">Teléfono</p>
              <a href="tel:+542614361188" class="text-sm text-light/80 hover:text-accent transition-colors">+54 261 436-1188</a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-9 h-9 bg-accent flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold tracking-widest uppercase text-light/40 mb-1">Email</p>
              <a href="mailto:info@hormimac.com.ar" class="text-sm text-light/80 hover:text-accent transition-colors break-all">info@hormimac.com.ar</a>
            </div>
          </div>
        </div>

        <!-- Google Maps embed -->
        <div class="relative w-full h-52 overflow-hidden border border-white/10">
          <iframe
            title="Ubicación Palumbo Hormigón"
            src="https://maps.google.com/maps?q=Acceso+Sur+Lateral+Este+8500+Lujan+de+Cuyo+Mendoza+Argentina&output=embed&hl=es&z=15"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>

      </div>
    </div>

  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      // TODO: integrate with backend / form service
      console.log('Form submitted');
    });
  }
</script>
