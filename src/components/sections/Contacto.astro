---
---

<section id="contacto" class="section-padding bg-[#fafafa]">
  <div class="section-container">

    <!-- Header -->
    <div class="mb-10">
      <div class="flex items-center gap-3 mb-4 gsap-reveal">
        <span class="block w-8 h-px bg-accent"></span>
        <span class="text-xs font-bold tracking-[0.3em] uppercase text-accent">Contacto</span>
      </div>
      <h2 class="section-title gsap-reveal text-balance mb-4">
        Ponete en contacto con nosotros
      </h2>
      <p class="section-subtitle max-w-lg gsap-reveal">
        Completá el formulario y un asesor te contactará dentro de las 24 horas hábiles.
      </p>
    </div>

    <!-- Form — full width -->
    <div class="gsap-reveal">
      <form
        name="contacto"
        method="POST"
        class="space-y-5 max-w-2xl mx-auto"
        novalidate
        id="contact-form"
      >
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label for="nombre" class="block text-xs font-bold tracking-widest uppercase text-dark/50 mb-2">
              Nombre *
            </label>
            <input
              type="text"
              id="nombre"
              name="nombre"
              required
              class="w-full bg-white border border-gray-300 text-dark placeholder-gray-400 px-4 py-3 text-sm focus:outline-none focus:border-accent transition-colors duration-200"
              placeholder="Juan Pérez"
            />
          </div>
          <div>
            <label for="empresa-input" class="block text-xs font-bold tracking-widest uppercase text-dark/50 mb-2">
              Empresa
            </label>
            <input
              type="text"
              id="empresa-input"
              name="empresa"
              class="w-full bg-white border border-gray-300 text-dark placeholder-gray-400 px-4 py-3 text-sm focus:outline-none focus:border-accent transition-colors duration-200"
              placeholder="Constructora XYZ"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label for="email" class="block text-xs font-bold tracking-widest uppercase text-dark/50 mb-2">
              Email *
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full bg-white border border-gray-300 text-dark placeholder-gray-400 px-4 py-3 text-sm focus:outline-none focus:border-accent transition-colors duration-200"
              placeholder="juan@ejemplo.com"
            />
          </div>
          <div>
            <label for="telefono" class="block text-xs font-bold tracking-widest uppercase text-dark/50 mb-2">
              Teléfono
            </label>
            <input
              type="tel"
              id="telefono"
              name="telefono"
              class="w-full bg-white border border-gray-300 text-dark placeholder-gray-400 px-4 py-3 text-sm focus:outline-none focus:border-accent transition-colors duration-200"
              placeholder="+54 261 000-0000"
            />
          </div>
        </div>

        <div>
          <label for="tipo" class="block text-xs font-bold tracking-widest uppercase text-dark/50 mb-2">
            Tipo de consulta *
          </label>
          <select
            id="tipo"
            name="tipo"
            required
            class="w-full bg-white border border-gray-300 text-dark px-4 py-3 text-sm focus:outline-none focus:border-accent transition-colors duration-200 appearance-none"
          >
            <option value="" disabled selected>Seleccioná una opción</option>
            <option value="cotizacion">Cotización de hormigón</option>
            <option value="obra-residencial">Obra residencial</option>
            <option value="obra-comercial">Obra comercial / industrial</option>
            <option value="obra-publica">Obra pública</option>
            <option value="especificaciones">Consulta técnica</option>
            <option value="otro">Otro</option>
          </select>
        </div>

        <div>
          <label for="mensaje" class="block text-xs font-bold tracking-widest uppercase text-dark/50 mb-2">
            Mensaje *
          </label>
          <textarea
            id="mensaje"
            name="mensaje"
            required
            rows="5"
            class="w-full bg-white border border-gray-300 text-dark placeholder-gray-400 px-4 py-3 text-sm focus:outline-none focus:border-accent transition-colors duration-200 resize-none"
            placeholder="Escribí tu consulta"
          ></textarea>
        </div>

        <div>
          <button
            type="submit"
            class="btn-primary w-full sm:w-auto justify-center"
          >
            Enviar consulta
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </button>
        </div>
      </form>
    </div>

    <!-- Google Maps embed — full width -->
    <div class="mt-14 w-full overflow-hidden border border-gray-200 gsap-reveal" style="height:380px;">
      <iframe
        title="Ubicación Palumbo Hormigón"
        src="https://maps.google.com/maps?q=Palumbo+Hormig%C3%B3n,+Luj%C3%A1n+de+Cuyo,+Mendoza&output=embed&hl=es&z=16"
        width="100%"
        height="100%"
        style="border:0;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>

  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      // TODO: integrate with backend / form service
      console.log('Form submitted');
    });
  }
</script>
