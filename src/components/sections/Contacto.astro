---
---

<section id="contacto" class="section-padding bg-[#fafafa]">
  <div class="section-container">

    <!-- Header -->
    <div class="mb-10">
      <div class="flex items-center gap-3 mb-4 gsap-reveal">
        <span class="block w-8 h-px bg-accent"></span>
        <span class="text-xs font-bold tracking-[0.3em] uppercase text-accent">Contacto</span>
      </div>
      <h2 class="section-title gsap-reveal text-balance mb-4">
        Ponete en contacto con nosotros
      </h2>
      <p class="section-subtitle max-w-lg gsap-reveal">
        Completá el formulario y un asesor te contactará dentro de las 24 horas hábiles.
      </p>
    </div>

    <!-- Form (3/5) + Mapa (2/5) -->
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-16">

      <!-- Form -->
      <div class="lg:col-span-3 gsap-reveal">
        <form
          name="contacto"
          method="POST"
          class="space-y-5"
          novalidate
          id="contact-form"
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="nombre" class="block text-xs font-bold tracking-widest uppercase text-dark/50 mb-2">
                Nombre *
              </label>
              <input
                type="text"
                id="nombre"
                name="nombre"
                required
                class="w-full bg-white border border-gray-300 text-dark placeholder-gray-400 px-4 py-3 text-sm focus:outline-none focus:border-accent transition-colors duration-200"
                placeholder="Juan Pérez"
              />
            </div>
            <div>
              <label for="empresa-input" class="block text-xs font-bold tracking-widest uppercase text-dark/50 mb-2">
                Empresa
              </label>
              <input
                type="text"
                id="empresa-input"
                name="empresa"
                class="w-full bg-white border border-gray-300 text-dark placeholder-gray-400 px-4 py-3 text-sm focus:outline-none focus:border-accent transition-colors duration-200"
                placeholder="Constructora XYZ"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="email" class="block text-xs font-bold tracking-widest uppercase text-dark/50 mb-2">
                Email *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full bg-white border border-gray-300 text-dark placeholder-gray-400 px-4 py-3 text-sm focus:outline-none focus:border-accent transition-colors duration-200"
                placeholder="juan@ejemplo.com"
              />
            </div>
            <div>
              <label for="telefono" class="block text-xs font-bold tracking-widest uppercase text-dark/50 mb-2">
                Teléfono
              </label>
              <input
                type="tel"
                id="telefono"
                name="telefono"
                class="w-full bg-white border border-gray-300 text-dark placeholder-gray-400 px-4 py-3 text-sm focus:outline-none focus:border-accent transition-colors duration-200"
                placeholder="+54 261 000-0000"
              />
            </div>
          </div>

          <div>
            <label for="mensaje" class="block text-xs font-bold tracking-widest uppercase text-dark/50 mb-2">
              Mensaje *
            </label>
            <textarea
              id="mensaje"
              name="mensaje"
              required
              rows="6"
              class="w-full bg-white border border-gray-300 text-dark placeholder-gray-400 px-4 py-3 text-sm focus:outline-none focus:border-accent transition-colors duration-200 resize-none"
              placeholder="Escribí tu consulta"
            ></textarea>
          </div>

          <div class="flex flex-col gap-3">
            <button
              type="submit"
              id="submit-btn"
              class="btn-primary w-full sm:w-auto justify-center"
            >
              <span id="submit-label">Enviar consulta</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </button>
            <p id="form-success" class="hidden text-sm text-green-600 font-medium">
              ¡Mensaje enviado! Te contactamos a la brevedad.
            </p>
            <p id="form-error" class="hidden text-sm text-red-600 font-medium">
              Hubo un error al enviar. Intentá de nuevo o escribinos a info@hormimac.com.ar
            </p>
          </div>
        </form>
      </div>

      <!-- Mapa -->
      <div class="lg:col-span-2 gsap-reveal">
        <div class="w-full h-full min-h-[360px] overflow-hidden border border-gray-200">
          <iframe
            title="Ubicación Palumbo Hormigón"
            src="https://maps.google.com/maps?q=Palumbo+Hormig%C3%B3n,+Luj%C3%A1n+de+Cuyo,+Mendoza&output=embed&hl=es&z=16"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const label = document.getElementById('submit-label') as HTMLElement | null;
  const success = document.getElementById('form-success') as HTMLElement | null;
  const error = document.getElementById('form-error') as HTMLElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!btn || !label || !success || !error) return;

    btn.disabled = true;
    label.textContent = 'Enviando...';
    success.classList.add('hidden');
    error.classList.add('hidden');

    const data = Object.fromEntries(new FormData(form));

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        success.classList.remove('hidden');
        form.reset();
      } else {
        error.classList.remove('hidden');
      }
    } catch {
      error.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      label.textContent = 'Enviar consulta';
    }
  });
</script>
