---
import HormigonCard from '@/components/ui/HormigonCard';

const hormigones = [
  {
    type: 'H-8',
    label: 'Hormigón H-8',
    description: 'Baja resistencia para trabajos de relleno, contrapisos livianos y hormigón de limpieza.',
    specs: ['80 kg/cm²', 'Contrapisos', 'Rellenos no estructurales'],
  },
  {
    type: 'H-13',
    label: 'Hormigón H-13',
    description: 'Uso general en veredas, pequeñas losas y elementos no estructurales.',
    specs: ['130 kg/cm²', 'Veredas y pavimentos ligeros', 'Muros de baja carga'],
  },
  {
    type: 'H-17',
    label: 'Hormigón H-17',
    description: 'Resistencia media para losas y fundaciones de construcciones residenciales.',
    specs: ['170 kg/cm²', 'Fundaciones residenciales', 'Losas y vigas'],
  },
  {
    type: 'H-20',
    label: 'Hormigón H-20',
    description: 'Estándar para la mayoría de obras de construcción civil y estructuras simples.',
    specs: ['200 kg/cm²', 'Uso general estructural', 'Columnas y vigas'],
  },
  {
    type: 'H-25',
    label: 'Hormigón H-25',
    description: 'Alta resistencia para estructuras que requieren mayor durabilidad y desempeño.',
    specs: ['250 kg/cm²', 'Losas y columnas exigentes', 'Estructuras sismo-resistentes'],
  },
  {
    type: 'H-30',
    label: 'Hormigón H-30',
    description: 'Hormigón de alta performance para estructuras de gran responsabilidad.',
    specs: ['300 kg/cm²', 'Grandes estructuras', 'Obras de infraestructura'],
  },
  {
    type: 'H-35',
    label: 'Hormigón H-35',
    description: 'Muy alta resistencia para proyectos de ingeniería de alta exigencia.',
    specs: ['350 kg/cm²', 'Puentes y viaductos', 'Estructuras industriales'],
  },
  {
    type: 'H-40',
    label: 'Hormigón H-40',
    description: 'Alta performance estructural para las obras de mayor exigencia mecánica.',
    specs: ['400 kg/cm²', 'Pilotes y fundaciones profundas', 'Grandes obras civiles'],
  },
];
---

<section id="hormigon" class="section-padding bg-surface">
  <div class="section-container">

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14">
      <div class="gsap-reveal">
        <div class="flex items-center gap-3 mb-4">
          <span class="block w-8 h-px bg-accent"></span>
          <span class="text-xs font-bold tracking-[0.3em] uppercase text-accent">Productos</span>
        </div>
        <h2 class="section-title text-balance">
          Nuestros Hormigones
        </h2>
      </div>
      <p class="section-subtitle max-w-md gsap-reveal text-balance">
        Producción certificada ISO 9001. Dosificación precisa y control de temperatura para cada tipo de obra.
      </p>
    </div>

    <!-- Mobile: horizontal scroll carousel -->
    <div
      class="sm:hidden -mx-4 overflow-x-auto pb-4 snap-x snap-mandatory flex gap-4 px-4"
      style="scrollbar-width:none;-webkit-overflow-scrolling:touch;"
    >
      {hormigones.map((item, i) => (
        <div class="snap-start shrink-0 w-[82vw]">
          <HormigonCard
            client:visible
            type={item.type}
            label={item.label}
            description={item.description}
            specs={item.specs}
            index={i}
          />
        </div>
      ))}
    </div>

    <!-- Desktop: grid -->
    <div class="hidden sm:grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
      {hormigones.map((item, i) => (
        <HormigonCard
          client:visible
          type={item.type}
          label={item.label}
          description={item.description}
          specs={item.specs}
          index={i}
        />
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-12 text-center gsap-reveal">
      <p class="text-muted mb-4 text-sm">¿Necesitás conocer las especificaciones técnicas de cada mezcla?</p>
      <a href="/recomendaciones" class="btn-outline">
        Ver recomendaciones técnicas
      </a>
    </div>

  </div>
</section>
