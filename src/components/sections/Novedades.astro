---
const noticias = [
  {
    source: 'Mundo ClubHouse',
    date: 'Abril 2026',
    headline: 'Pablo Navarro: "Nos diferencia la calidad del hormigón que elaboramos"',
    excerpt:
      'Entrevista al Jefe de Ventas de Palumbo S.A. sobre cómo la empresa se posiciona a través de la calidad, la certificación ISO y la capacitación continua del equipo.',
    tag: 'Entrevista',
    url: 'https://mundoclubhouse.com/2026/04/03/entrevista-pablo-navarro-nos-diferencia-la-calidad-del-hormigon-que-elaboramos/',
    external: true,
  },
  {
    source: 'Próximamente',
    date: '',
    headline: 'Seguimos sumando presencia en medios',
    excerpt:
      'Estamos trabajando para traerte más novedades sobre Palumbo Hormigón en los principales medios de Mendoza.',
    tag: '',
    url: '#',
    external: false,
  },
  {
    source: 'Próximamente',
    date: '',
    headline: 'Novedades institucionales',
    excerpt:
      'Obras, certificaciones, nuevos servicios y más. Seguinos para estar al tanto de todas las novedades de la empresa.',
    tag: '',
    url: '#',
    external: false,
  },
];
---

<section id="novedades" class="section-padding bg-[#fafafa]">
  <div class="section-container">

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14">
      <div class="gsap-reveal">
        <div class="flex items-center gap-3 mb-4">
          <span class="block w-8 h-px bg-accent"></span>
          <span class="text-xs font-bold tracking-[0.3em] uppercase text-accent">Prensa</span>
        </div>
        <h2 class="section-title text-balance">En los Medios</h2>
      </div>
      <p class="section-subtitle max-w-xs gsap-reveal">
        Lo que dicen los medios sobre Palumbo Hormigón.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {noticias.map((item, i) => (
        <article
          class="gsap-reveal group bg-white border border-gray-100 hover:border-accent/40 hover:shadow-lg transition-all duration-300 flex flex-col"
          style={`transition-delay: ${i * 100}ms`}
        >
          <!-- Top bar with source -->
          <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 bg-surface">
            <span class="text-xs font-black tracking-widest uppercase text-dark">{item.source}</span>
            <span class="text-xs font-medium text-muted">{item.date}</span>
          </div>

          <!-- Content -->
          <div class="p-6 flex flex-col flex-1">
            <!-- Tag -->
            <span class="inline-block mb-3 text-[10px] font-bold tracking-widest uppercase bg-accent/15 text-dark px-2 py-0.5 self-start">
              {item.tag}
            </span>

            <!-- Headline -->
            <h3 class="text-base font-bold text-dark leading-snug mb-3 group-hover:text-accent transition-colors duration-200">
              {item.headline}
            </h3>

            <!-- Excerpt -->
            <p class="text-sm text-muted leading-relaxed flex-1">{item.excerpt}</p>

            <!-- Link -->
            <a
              href={item.url}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener' : undefined}
              class={`mt-5 inline-flex items-center gap-1.5 text-xs font-bold tracking-widest uppercase transition-colors duration-200 border-b border-transparent pb-0.5 ${item.url === '#' ? 'text-muted cursor-default pointer-events-none' : 'text-dark hover:text-accent hover:border-accent'}`}
              aria-label={`Leer nota completa: ${item.headline}`}
            >
              {item.url === '#' ? 'Próximamente' : 'Leer nota completa'}
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
