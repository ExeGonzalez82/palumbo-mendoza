---
const items = [
  { src: '/galeria/galeria-01.webp', aspect: 'aspect-video', span2: true },
  { src: '/galeria/galeria-02.webp', aspect: 'aspect-video', span2: false },
  { src: '/galeria/galeria-03.webp', aspect: 'aspect-square', span2: false },
  { src: '/galeria/galeria-04.webp', aspect: 'aspect-square', span2: false },
  { src: '/galeria/galeria-05.webp', aspect: 'aspect-square', span2: false },
  { src: '/galeria/galeria-06.webp', aspect: 'aspect-video', span2: true },
  { src: '/galeria/galeria-07.webp', aspect: 'aspect-video', span2: false },
  { src: '/galeria/galeria-08.webp', aspect: 'aspect-video', span2: false },
  { src: '/galeria/galeria-09.webp', aspect: 'aspect-video', span2: false },
];
---

<section id="galeria" class="section-padding bg-surface">
  <div class="section-container">

    <!-- Header -->
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-4 gsap-reveal">
        <span class="block w-8 h-px bg-accent"></span>
        <span class="text-xs font-bold tracking-[0.3em] uppercase text-accent">Galería</span>
      </div>
      <h2 class="section-title gsap-reveal text-balance">
        Nuestro Trabajo
      </h2>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 gsap-reveal">
      {items.map((item) => (
        <div class={`relative group overflow-hidden ${item.aspect} ${item.span2 ? 'col-span-2' : ''}`}>
          <img
            src={item.src}
            alt="Palumbo Hormigón"
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-dark/0 group-hover:bg-dark/30 transition-colors duration-300" />
        </div>
      ))}
    </div>

  </div>
</section>
