---
// Placeholder gallery items — replace with real images
const items = [
  { label: 'Planta de producción', aspect: 'aspect-video', bg: 'bg-stone-300' },
  { label: 'Camión mixer en obra', aspect: 'aspect-square', bg: 'bg-stone-400' },
  { label: 'Hormigonado de losa', aspect: 'aspect-square', bg: 'bg-stone-200' },
  { label: 'Control de calidad', aspect: 'aspect-video', bg: 'bg-neutral-300' },
  { label: 'Obra residencial', aspect: 'aspect-square', bg: 'bg-stone-300' },
  { label: 'Infraestructura vial', aspect: 'aspect-video', bg: 'bg-neutral-400' },
  { label: 'Planta dosificadora', aspect: 'aspect-square', bg: 'bg-stone-200' },
  { label: 'Equipo en trabajo', aspect: 'aspect-square', bg: 'bg-stone-400' },
];
---

<section id="galeria" class="section-padding bg-surface">
  <div class="section-container">

    <!-- Header -->
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-4 gsap-reveal">
        <span class="block w-8 h-px bg-accent"></span>
        <span class="text-xs font-bold tracking-[0.3em] uppercase text-accent">Galería</span>
      </div>
      <h2 class="section-title gsap-reveal text-balance">
        Nuestro Trabajo
      </h2>
    </div>

    <!-- Masonry-like grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 gsap-reveal">
      {items.map((item, i) => (
        <div
          class={`relative group overflow-hidden ${item.aspect} ${item.bg} cursor-pointer`}
          style={i === 0 || i === 5 ? 'grid-column: span 2' : ''}
        >
          <!-- Placeholder content (replace with <img> tags) -->
          <div class="absolute inset-0 flex items-end p-4">
            <div class="translate-y-0 sm:translate-y-full sm:group-hover:translate-y-0 transition-transform duration-300 ease-out w-full">
              <p class="text-xs font-bold text-white uppercase tracking-widest bg-dark/70 px-3 py-1.5 inline-block">
                {item.label}
              </p>
            </div>
          </div>

          <!-- Overlay -->
          <div class="absolute inset-0 bg-dark/0 group-hover:bg-dark/20 transition-colors duration-300" />

          <!-- Zoom icon -->
          <div class="absolute top-3 right-3 w-8 h-8 bg-accent flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <svg class="w-4 h-4 text-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
            </svg>
          </div>

          <!-- Placeholder label (remove when using real images) -->
          <div class="absolute inset-0 flex items-center justify-center opacity-30">
            <span class="text-xs font-bold text-dark/60 tracking-wider uppercase">Imagen próximamente</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
