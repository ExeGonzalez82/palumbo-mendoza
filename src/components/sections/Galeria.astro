---
const items = [
  { src: '/galeria/galeria-01.webp', aspect: 'aspect-video', span2: true },
  { src: '/galeria/galeria-02.webp', aspect: 'aspect-video', span2: false },
  { src: '/galeria/galeria-03.webp', aspect: 'aspect-square', span2: false },
  { src: '/galeria/galeria-04.webp', aspect: 'aspect-square', span2: false },
  { src: '/galeria/galeria-05.webp', aspect: 'aspect-square', span2: false },
  { src: '/galeria/galeria-06.webp', aspect: 'aspect-video', span2: true },
  { src: '/galeria/galeria-07.webp', aspect: 'aspect-video', span2: false },
  { src: '/galeria/galeria-08.webp', aspect: 'aspect-video', span2: false },
  { src: '/galeria/galeria-09.webp', aspect: 'aspect-video', span2: false },
];
---

<section id="galeria" class="section-padding bg-surface">
  <div class="section-container">

    <!-- Header -->
    <div class="mb-12 gsap-reveal">
      <div class="flex items-center gap-3 mb-4">
        <span class="block w-8 h-px bg-accent"></span>
        <span class="text-xs font-bold tracking-[0.3em] uppercase text-accent">Galería</span>
      </div>
      <h2 class="section-title text-balance">
        Nuestro Trabajo
      </h2>
    </div>

    <!-- Grid -->
    <div id="gallery-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
      {items.map((item) => (
        <button
          class={`gallery-item relative group overflow-hidden ${item.aspect} ${item.span2 ? 'col-span-2' : ''} cursor-zoom-in`}
          data-lightbox={item.src}
          aria-label="Ver imagen ampliada"
        >
          <img
            src={item.src}
            alt="Palumbo Hormigón"
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-dark/0 group-hover:bg-dark/30 transition-colors duration-300" />
        </button>
      ))}
    </div>

  </div>
</section>

<!-- Lightbox -->
<div
  id="lightbox"
  class="fixed inset-0 z-[100] bg-black/90 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300 p-4"
  aria-hidden="true"
>
  <button
    id="lightbox-close"
    aria-label="Cerrar"
    class="absolute top-4 right-4 w-10 h-10 flex items-center justify-center text-white/60 hover:text-white transition-colors"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
    </svg>
  </button>
  <img
    id="lightbox-img"
    src=""
    alt="Palumbo Hormigón"
    class="max-w-full max-h-[90vh] object-contain shadow-2xl"
  />
</div>

<script>
  const lightbox = document.getElementById('lightbox')!;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxClose = document.getElementById('lightbox-close')!;

  function openLightbox(src: string) {
    lightboxImg.src = src;
    lightbox.classList.remove('opacity-0', 'pointer-events-none');
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox.classList.add('opacity-0', 'pointer-events-none');
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((btn) => {
    btn.addEventListener('click', () => openLightbox(btn.dataset.lightbox!));
  });

  lightboxClose.addEventListener('click', closeLightbox);

  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>
