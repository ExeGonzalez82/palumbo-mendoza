---
const navLinks = [
  { label: 'Empresa', href: '/#empresa' },
  { label: 'Hormigón', href: '/#hormigon' },
  { label: 'Equipo', href: '/#staff' },
  { label: 'Novedades', href: '/#novedades' },
  { label: 'Galería', href: '/#galeria' },
  { label: 'Contacto', href: '/#contacto' },
];

const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  data-scrolled="false"
>
  <div class="section-container">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <a href="/" class="flex flex-col leading-none group" aria-label="Palumbo Hormigón - Inicio">
        <span
          class="text-xl md:text-2xl font-black tracking-tight text-light group-hover:text-accent transition-colors duration-200"
        >
          PALUMBO
        </span>
        <span
          class="text-[10px] md:text-xs font-semibold tracking-[0.2em] text-accent uppercase"
        >
          HORMIGÓN
        </span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-8" aria-label="Navegación principal">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="text-sm font-medium text-light/80 hover:text-accent transition-colors duration-200 tracking-wide"
            >
              {link.label}
            </a>
          ))
        }
        <a
          href="/#contacto"
          class="ml-4 bg-accent text-dark text-sm font-bold px-5 py-2.5 tracking-widest uppercase transition-all duration-200 hover:bg-yellow-400"
        >
          Cotizá
        </a>
      </nav>

      <!-- Mobile hamburger -->
      <button
        id="menu-toggle"
        class="lg:hidden flex flex-col gap-1.5 p-2 group"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span
          class="block w-6 h-0.5 bg-light transition-all duration-300 group-[.open]:rotate-45 group-[.open]:translate-y-2"
        ></span>
        <span
          class="block w-6 h-0.5 bg-light transition-all duration-300 group-[.open]:opacity-0"
        ></span>
        <span
          class="block w-6 h-0.5 bg-light transition-all duration-300 group-[.open]:-rotate-45 group-[.open]:-translate-y-2"
        ></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden bg-dark border-t border-white/10"
    aria-hidden="true"
  >
    <nav class="section-container py-6 flex flex-col gap-4">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-base font-medium text-light/80 hover:text-accent transition-colors duration-200 py-1"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/#contacto"
        class="mt-2 inline-block bg-accent text-dark text-sm font-bold px-5 py-3 tracking-widest uppercase text-center"
      >
        Cotizá ahora
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const menuToggle = document.getElementById('menu-toggle')!;
  const mobileMenu = document.getElementById('mobile-menu')!;

  // Scroll behavior: transparent on top, solid dark on scroll
  const onScroll = () => {
    const scrolled = window.scrollY > 40;
    header.setAttribute('data-scrolled', String(scrolled));
    if (scrolled) {
      header.classList.add('bg-dark', 'shadow-lg');
      header.classList.remove('bg-transparent');
    } else {
      header.classList.remove('bg-dark', 'shadow-lg');
      header.classList.add('bg-transparent');
    }
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll(); // run on load

  // Mobile menu toggle
  menuToggle.addEventListener('click', () => {
    const isOpen = mobileMenu.classList.contains('hidden');
    mobileMenu.classList.toggle('hidden', !isOpen);
    mobileMenu.setAttribute('aria-hidden', String(!isOpen));
    menuToggle.setAttribute('aria-expanded', String(isOpen));
    menuToggle.classList.toggle('open', isOpen);
  });

  // Close mobile menu when a link is clicked
  mobileMenu.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      mobileMenu.setAttribute('aria-hidden', 'true');
      menuToggle.setAttribute('aria-expanded', 'false');
      menuToggle.classList.remove('open');
    });
  });
</script>

<style>
  #site-header {
    background: transparent;
  }

  #site-header[data-scrolled='true'] {
    background: #111111;
    box-shadow: 0 1px 20px rgba(0, 0, 0, 0.3);
  }
</style>
