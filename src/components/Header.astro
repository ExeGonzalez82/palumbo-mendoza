---
const navLinks = [
  { label: 'Empresa', href: '/#empresa' },
  { label: 'Hormigón', href: '/#hormigon' },
  { label: 'Galería', href: '/#galeria' },
  { label: 'Contacto', href: '/#contacto' },
];
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 bg-[#fafafa] transition-shadow duration-300"
>
  <div class="section-container">
    <div class="flex items-center justify-between h-16 md:h-20">

      <!-- Logo — far left -->
      <a href="/" aria-label="Palumbo Hormigón - Inicio" class="flex items-center shrink-0">
        <img
          src="/palumbo_logo.svg"
          alt="Palumbo Hormigón"
          class="h-9 md:h-11 w-auto"
          width="270"
          height="109"
        />
      </a>

      <!-- Desktop nav — center -->
      <nav class="hidden lg:flex items-center gap-7 xl:gap-8" aria-label="Navegación principal">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="text-sm font-medium text-dark/70 hover:text-accent transition-colors duration-200 tracking-wide"
            >
              {link.label}
            </a>
          ))
        }
        <a
          href="/#contacto"
          class="ml-2 bg-accent text-dark text-sm font-bold px-5 py-2.5 tracking-widest uppercase transition-all duration-200 hover:bg-yellow-300"
        >
          Solicitá presupuesto
        </a>
      </nav>

      <!-- Right side: ISO badge (desktop) / hamburger (mobile) — far right -->
      <div class="flex items-center gap-3 shrink-0">
        <a
          href="/certificado-iso9001.pdf"
          target="_blank"
          rel="noopener"
          aria-label="Ver certificado ISO 9001:2015"
          title="Ver certificado ISO 9001:2015"
          class="hidden lg:block opacity-90 hover:opacity-100 transition-opacity duration-200"
        >
          <img
            src="/iso9001.svg"
            alt="Certificación ISO 9001:2015"
            class="h-12 w-auto"
            width="193"
            height="67"
          />
        </a>

        <button
          id="menu-toggle"
          class="lg:hidden flex flex-col gap-1.5 p-2 group"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span class="block w-6 h-0.5 bg-dark transition-all duration-300 group-[.open]:rotate-45 group-[.open]:translate-y-2"></span>
          <span class="block w-6 h-0.5 bg-dark transition-all duration-300 group-[.open]:opacity-0"></span>
          <span class="block w-6 h-0.5 bg-dark transition-all duration-300 group-[.open]:-rotate-45 group-[.open]:-translate-y-2"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden bg-[#fafafa] border-t border-black/10"
    aria-hidden="true"
  >
    <nav class="section-container py-6 flex flex-col gap-4" aria-label="Menú móvil">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-base font-medium text-dark/70 hover:text-accent transition-colors duration-200 py-1"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/#contacto"
        class="mt-2 inline-block bg-accent text-dark text-sm font-bold px-5 py-3 tracking-widest uppercase text-center"
      >
        Solicitá presupuesto
      </a>
      <a
        href="/certificado-iso9001.pdf"
        target="_blank"
        rel="noopener"
        aria-label="Ver certificado ISO 9001:2015"
        class="mt-1"
      >
        <img
          src="/iso9001.svg"
          alt="Certificación ISO 9001:2015"
          class="h-8 w-auto"
          width="193"
          height="67"
        />
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const menuToggle = document.getElementById('menu-toggle')!;
  const mobileMenu = document.getElementById('mobile-menu')!;

  // Borde y sombra solo cuando se scrollea
  const onScroll = () => {
    if (window.scrollY > 8) {
      header.style.boxShadow = '0 1px 12px rgba(0,0,0,0.08)';
      header.style.borderBottom = '1px solid rgba(0,0,0,0.08)';
    } else {
      header.style.boxShadow = '';
      header.style.borderBottom = '';
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  menuToggle.addEventListener('click', () => {
    const isOpen = mobileMenu.classList.contains('hidden');
    mobileMenu.classList.toggle('hidden', !isOpen);
    mobileMenu.setAttribute('aria-hidden', String(!isOpen));
    menuToggle.setAttribute('aria-expanded', String(isOpen));
    menuToggle.classList.toggle('open', isOpen);
  });

  mobileMenu.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      mobileMenu.setAttribute('aria-hidden', 'true');
      menuToggle.setAttribute('aria-expanded', 'false');
      menuToggle.classList.remove('open');
    });
  });
</script>
