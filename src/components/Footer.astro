---
const navLinks = [
  { label: 'Empresa', href: '/#empresa' },
  { label: 'Hormigón', href: '/#hormigon' },
  { label: 'Equipo', href: '/#staff' },
  { label: 'Novedades', href: '/#novedades' },
  { label: 'Galería', href: '/#galeria' },
  { label: 'Recomendaciones', href: '/recomendaciones' },
];

const year = new Date().getFullYear();
---

<footer class="bg-dark text-light">
  <!-- Top bar -->
  <div class="border-b border-white/10">
    <div class="section-container py-12 md:py-16">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-8">

        <!-- Brand column -->
        <div class="md:col-span-1">
          <a href="/" class="flex flex-col leading-none mb-5" aria-label="Palumbo Hormigón">
            <span class="text-2xl font-black tracking-tight text-light">PALUMBO</span>
            <span class="text-xs font-semibold tracking-[0.2em] text-accent uppercase">HORMIGÓN</span>
          </a>
          <p class="text-sm text-light/60 leading-relaxed max-w-xs">
            Empresa de hormigón elaborado con sede en Mendoza, Argentina.
            Más de 30 años brindando calidad y confianza al sector de la construcción.
          </p>
          <!-- ISO Badge -->
          <div class="mt-6 inline-flex items-center gap-2 border border-accent/40 px-3 py-1.5">
            <svg class="w-4 h-4 text-accent" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-xs font-bold text-accent tracking-widest uppercase">ISO 9001 Certificado</span>
          </div>
        </div>

        <!-- Nav column -->
        <div>
          <h3 class="text-xs font-bold tracking-widest uppercase text-light/40 mb-5">Navegación</h3>
          <ul class="flex flex-col gap-3">
            {navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-light/70 hover:text-accent transition-colors duration-200"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Contact column -->
        <div>
          <h3 class="text-xs font-bold tracking-widest uppercase text-light/40 mb-5">Contacto</h3>
          <ul class="flex flex-col gap-4">
            <li class="flex items-start gap-3">
              <svg class="w-4 h-4 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span class="text-sm text-light/70 leading-snug">Acc. Sur - Lat. Este 8500<br/>Luján de Cuyo, Mendoza</span>
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-4 h-4 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 8V5z"/>
              </svg>
              <a href="tel:+542614361188" class="text-sm text-light/70 hover:text-accent transition-colors">+54 261 436-1188</a>
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-4 h-4 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <a href="mailto:info@hormimac.com.ar" class="text-sm text-light/70 hover:text-accent transition-colors">info@hormimac.com.ar</a>
            </li>
          </ul>
        </div>

      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="section-container py-5">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-light/40">
        &copy; {year} Palumbo Hormigón. Todos los derechos reservados.
      </p>
      <p class="text-xs text-light/30">
        Mendoza, Argentina
      </p>
    </div>
  </div>
</footer>
