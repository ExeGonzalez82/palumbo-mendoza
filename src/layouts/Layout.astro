---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Palumbo Hormigón | Hormigón Elaborado en Mendoza',
  description = 'Empresa de hormigón elaborado certificada ISO 9001 en Mendoza, Argentina. Más de 30 años produciendo hormigón de calidad en Luján de Cuyo.',
  ogImage = '/og-image.jpg',
} = Astro.props;

const siteBase = Astro.site?.origin ?? 'https://palumbomza.com.ar';
const canonicalURL = new URL(Astro.url.pathname, siteBase);
const ogImageURL = ogImage.startsWith('http') ? ogImage : `${siteBase}${ogImage}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#111111" />

    <!-- Keywords & authorship -->
    <meta name="keywords" content="hormigón elaborado Mendoza, hormigón premezclado, planta de hormigón Luján de Cuyo, Palumbo Hormigón, hormigón ISO 9001, H-8 H-13 H-17 H-20 H-25 H-30 H-35 H-40" />
    <meta name="author" content="Palumbo Hormigón" />

    <!-- Geo tags -->
    <meta name="geo.region" content="AR-M" />
    <meta name="geo.placename" content="Luján de Cuyo, Mendoza, Argentina" />
    <meta name="geo.position" content="-33.0330;-68.8820" />
    <meta name="ICBM" content="-33.0330, -68.8820" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Palumbo Hormigón" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <title>{title}</title>

    <!-- Structured data — LocalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Palumbo Hormigón",
      "description": "Empresa de hormigón elaborado certificada ISO 9001:2015 en Mendoza, Argentina. Más de 30 años de trayectoria.",
      "url": siteBase,
      "logo": `${siteBase}/palumbo_logo.svg`,
      "image": ogImageURL,
      "telephone": "+542614361188",
      "email": "info@hormimac.com.ar",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Acc. Sur - Lat. Este 8500",
        "addressLocality": "Luján de Cuyo",
        "addressRegion": "Mendoza",
        "addressCountry": "AR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -33.0330,
        "longitude": -68.8820
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "08:00",
        "closes": "17:00"
      },
      "sameAs": ["https://www.facebook.com/palumbohormigon/"],
      "hasCredential": {
        "@type": "EducationalOccupationalCredential",
        "credentialCategory": "ISO 9001:2015"
      }
    })} />

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main id="main-content" class="pt-16 md:pt-20">
      <slot />
    </main>
    <Footer />

    <!-- WhatsApp flotante -->
    <a
      id="whatsapp-btn"
      href="https://wa.me/5492612065244"
      target="_blank"
      rel="noopener"
      aria-label="Contactar por WhatsApp"
      class="fixed bottom-24 right-6 z-50 flex items-center justify-center bg-[#25D366] text-white shadow-lg rounded-full opacity-0 translate-y-2 pointer-events-none transition-all duration-300"
      style="width:48px;height:48px;"
    >
      <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>

    <!-- Scroll to top button -->
    <button
      id="scroll-top"
      aria-label="Volver arriba"
      class="fixed bottom-6 right-6 z-50 w-11 h-11 flex items-center justify-center bg-[#111111] text-white border border-white/10 opacity-0 translate-y-2 pointer-events-none transition-all duration-300 hover:bg-[#f7c915] hover:text-[#111111] hover:border-[#f7c915]"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7" />
      </svg>
    </button>

    <!-- Lenis smooth scroll initialization -->
    <script>
      import Lenis from 'lenis';

      const lenis = new Lenis({
        duration: 1.2,
        easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        orientation: 'vertical',
        smoothWheel: true,
      });

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }

      requestAnimationFrame(raf);

      // Expose lenis globally for GSAP integration
      (window as Window & { lenis?: Lenis }).lenis = lenis;

      // Logo click → smooth scroll to top (only when already on home page)
      document.querySelectorAll<HTMLAnchorElement>('a[href="/"]').forEach((logo) => {
        logo.addEventListener('click', (e) => {
          if (window.location.pathname === '/') {
            e.preventDefault();
            lenis.scrollTo(0, { duration: 1.4 });
          }
        });
      });

      // Scroll to top + WhatsApp buttons
      const scrollTopBtn = document.getElementById('scroll-top')!;
      const waBtn = document.getElementById('whatsapp-btn')!;
      const floatingBtns = [scrollTopBtn, waBtn];
      window.addEventListener('scroll', () => {
        if (window.scrollY > 400) {
          floatingBtns.forEach(btn => {
            btn.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none');
            btn.classList.add('opacity-100', 'translate-y-0');
          });
        } else {
          floatingBtns.forEach(btn => {
            btn.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
            btn.classList.remove('opacity-100', 'translate-y-0');
          });
        }
      }, { passive: true });
      scrollTopBtn.addEventListener('click', () => {
        lenis.scrollTo(0, { duration: 1.4 });
      });

      // Smooth scroll para anchor links (#section y /#section)
      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"], a[href*="/#"]').forEach((anchor) => {
        anchor.addEventListener('click', (e) => {
          const href = anchor.getAttribute('href') ?? '';
          const hashIndex = href.indexOf('#');
          if (hashIndex === -1) return;
          const hash = href.slice(hashIndex);
          const target = document.querySelector(hash);
          if (!target) return;
          e.preventDefault();
          const headerH = window.innerWidth >= 1024 ? 80 : 64;
          lenis.scrollTo(target as HTMLElement, { offset: -headerH, duration: 1.4 });
        });
      });
    </script>

    <!-- GSAP ScrollTrigger initialization -->
    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      document.addEventListener('DOMContentLoaded', () => {
        // Group .gsap-reveal elements by parent — stagger siblings together
        const reveals = gsap.utils.toArray<HTMLElement>('.gsap-reveal');
        const groups = new Map<Element, HTMLElement[]>();
        reveals.forEach((el) => {
          const parent = el.parentElement!;
          if (!groups.has(parent)) groups.set(parent, []);
          groups.get(parent)!.push(el);
        });
        groups.forEach((children, parent) => {
          gsap.fromTo(
            children,
            { opacity: 0, y: 28 },
            {
              opacity: 1,
              y: 0,
              duration: 0.7,
              ease: 'power3.out',
              stagger: 0.13,
              scrollTrigger: {
                trigger: parent,
                start: 'top 92%',
                once: true,
              },
            }
          );
        });

        // Counter animation for stats
        document.querySelectorAll<HTMLElement>('[data-counter]').forEach((el) => {
          const target = parseInt(el.dataset.counter ?? '0', 10);
          const prefix = el.dataset.prefix ?? '';
          const formatK = el.dataset.formatK === 'true';
          const obj = { val: 0 };
          ScrollTrigger.create({
            trigger: el,
            start: 'top 85%',
            once: true,
            onEnter: () => {
              gsap.to(obj, {
                val: target,
                duration: 1.6,
                ease: 'power2.out',
                onUpdate: () => {
                  const v = Math.round(obj.val);
                  el.textContent = formatK
                    ? prefix + v.toLocaleString('es-AR')
                    : prefix + v;
                },
              });
            },
          });
        });
      });
    </script>
  </body>
</html>
